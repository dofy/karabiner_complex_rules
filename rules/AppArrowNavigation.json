{
  "title": "App-specific Arrow Navigation",
  "maintainers": [
    "dofy"
  ],
  "rules": [
    {
      "description": "iTerm2: ctrl+arrow to tmux prev/next window",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.googlecode\\.iterm2$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "left_arrow",
            "modifiers": {
              "mandatory": [
                "control"
              ],
              "optional": [
                "fn",
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "hold_down_milliseconds": 30,
              "key_code": "a",
              "modifiers": [
                "left_control"
              ]
            },
            {
              "key_code": "h",
              "modifiers": [
                "left_control"
              ]
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.googlecode\\.iterm2$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "right_arrow",
            "modifiers": {
              "mandatory": [
                "control"
              ],
              "optional": [
                "fn",
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "hold_down_milliseconds": 30,
              "key_code": "a",
              "modifiers": [
                "left_control"
              ]
            },
            {
              "key_code": "l",
              "modifiers": [
                "left_control"
              ]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Chrome: ctrl+arrow history back/forward, volume keys switch tabs",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "left_arrow",
            "modifiers": {
              "mandatory": [
                "control"
              ],
              "optional": [
                "fn",
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "open_bracket",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "right_arrow",
            "modifiers": {
              "mandatory": [
                "control"
              ],
              "optional": [
                "fn",
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "close_bracket",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "consumer_key_code": "volume_decrement",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "close_bracket",
              "modifiers": [
                "left_command",
                "left_shift"
              ]
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "consumer_key_code": "volume_increment",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "open_bracket",
              "modifiers": [
                "left_command",
                "left_shift"
              ]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
